# Copie para .env (que NÃO é versionado) e preencha os valores:  cp .env.example .env
# No pipeline, esses valores vêm dos Secrets/Variables dos Environments do GitHub (homologacao / producao)

# --- Segredos (no GitHub: Settings > Environments > <ambiente> > Secrets) ---
POSTGRES_PASSWORD=

# --- Configurações não sensíveis (no GitHub: Environment variables) ---
POSTGRES_DB=media_escolar
POSTGRES_USER=media_escolar
APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# Imagem e versão da API (tag publicada no GHCR, sem o "v"). Vazio/latest + "docker compose up --build" = build local
APP_IMAGE=ghcr.io/enzoblousa/boletim-escolar
APP_VERSION=latest

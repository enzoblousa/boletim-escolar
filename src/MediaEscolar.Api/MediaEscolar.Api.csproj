<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Versão semântica padrão; no pipeline é sobrescrita pela tag git (ex.: v1.2.3 -> -p:Version=1.2.3) -->
    <Version>1.0.0</Version>
    <!-- Evita o sufixo "+<hash do commit>" na versão exposta em /version -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core + provider do PostgreSQL (persistência dos alunos) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <!-- Health check que testa a conexão com o banco, exposto em /health -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MediaEscolar.Tests" />
  </ItemGroup>

</Project>
